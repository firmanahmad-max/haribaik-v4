# Salin file ini menjadi .env lalu isi API key Sumopod kamu.
# Format key Sumopod: sk-xxxxx (BUKAN sk-ant-xxxxx)
SUMOPOD_API_KEY=sk-xxxxx

# Opsional: port server (default 3000)
# PORT=3000

# Opsional: set ke "1" untuk memakai respons tiruan tanpa memanggil Sumopod
# (berguna untuk menguji logika rotasi tanpa API key).
# MOCK_AI=0
