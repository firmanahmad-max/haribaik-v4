# Salin file ini menjadi .env lalu isi API key Sumopod kamu.
# Format key Sumopod: sk-xxxxx (BUKAN sk-ant-xxxxx)
SUMOPOD_API_KEY=sk-xxxxx

# Opsional: port server (default 3000)
# PORT=3000

# Opsional: set ke "1" untuk memakai respons tiruan tanpa memanggil Sumopod
# (berguna untuk menguji logika rotasi tanpa API key).
# MOCK_AI=0

# Opsional: set ke "1" untuk menyertakan cuplikan respons mentah AI di pesan error
# (hanya untuk debug; biarkan kosong/0 di produksi).
# DEBUG=0

# Opsional: rate limit per-IP untuk /api/chat (default 20 request / 60000 ms).
# RATE_LIMIT_MAX=20
# RATE_LIMIT_WINDOW_MS=60000

# ===== Notifikasi latar / Web Push (Fase 4 #3) =====
# Hasilkan pasangan kunci: node scripts/gen-vapid.mjs
# PUBLIC sudah ditaruh di docs/js/config.js; isi PRIVATE di sini (server saja).
# VAPID_PUBLIC_KEY=BHjh...   (sama dengan di config.js)
# VAPID_PRIVATE_KEY=xxxxx
# VAPID_SUBJECT=mailto:admin@haribaik.app
#
# Untuk scheduler (kirim adzan/pengingat) backend perlu membaca semua langganan
# memakai SERVICE ROLE KEY Supabase (RAHASIA — server saja, JANGAN di frontend).
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...service_role...
